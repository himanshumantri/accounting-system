# Used for local runs. On Cloud Run these are set by the GitLab deploy job from CI/CD variables (see WEB.md).

# Neon connection string (use the "pooled" one, host contains -pooler). Leave unset locally to use SQLite.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require
# Browser origins allowed to call the API, comma separated (your GitLab Pages origin)
CORS_ORIGINS=http://localhost:5173
# Secret for POST /recurring/run, sent in the X-Run-Token header (leave empty to disable that endpoint)
RECURRING_RUN_TOKEN=change-me
# Calendar used for "today" (recurring entries, defaults). Cloud Run itself runs in UTC.
APP_TIMEZONE=UTC
